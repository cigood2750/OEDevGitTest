<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.1.0" />
  <PropertyGroup>
    <Name>xGitTest</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql170DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>{def46f32-691a-4ef4-ad4a-9f45a2a26ae7}</ProjectGuid>
    <TargetDatabaseSet>True</TargetDatabaseSet>
  </PropertyGroup>
  <!-- Cursor/VS Solution Explorer shows None/Compile items, not the SDK's Build glob. -->
  <ItemGroup>
    <None Include="**/*.sql" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="dbo\" />
    <Folder Include="dbo\Functions\" />
    <Folder Include="dbo\StoredProcedures\" />
    <Folder Include="dbo\Tables\" />
  </ItemGroup>
  <ItemGroup>
    <PreDeploy Include="050 PreScript.sql" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="900 PostScript.sql" />
  </ItemGroup>
</Project>