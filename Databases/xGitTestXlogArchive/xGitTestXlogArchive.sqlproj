<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.1.0" />
  <PropertyGroup>
    <Name>xGitTestXlogArchive</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql170DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>{e7651ab5-bb13-4f61-9355-bb44dbf33b03}</ProjectGuid>
    <TargetDatabaseSet>True</TargetDatabaseSet>
  </PropertyGroup>
  <!-- Cursor/VS Solution Explorer shows None/Compile items, not the SDK's Build glob. -->
  <ItemGroup>
    <None Include="**/*.sql" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="dbo\" />
    <Folder Include="dbo\Tables\" />
  </ItemGroup>
</Project>